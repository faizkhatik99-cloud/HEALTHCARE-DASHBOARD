      <aliases enabled='yes' />
      <column caption='StayPatientDay' datatype='string' name='[Calculation_708472524850122752]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Length of Stay (Days)]&lt;= 2 THEN &apos;Short Stay&apos;&#13;&#10;ELSEIF  [Length of Stay (Days)] &lt;= 5 THEN &apos;Medium Stay&apos;&#13;&#10;ELSE &apos;long Stay&apos;&#13;&#10;END' />
      </column>
      <column caption='AgeGroup' datatype='string' name='[Calculation_708472524851310593]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt;= 18 THEN &apos;child&apos;&#13;&#10;ELSEIF  [Age] &lt;= 35 THEN &apos;Adult&apos;&#13;&#10;ELSEIF  [Age] &lt;= 80 THEN &apos;old&apos;&#13;&#10;ELSE &apos;too old&apos;&#13;&#10;END' />
      </column>
      <column caption='Total Patient' datatype='integer' name='[Calculation_708472524853026818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Patient ID])' />
      </column>
      <column caption='MonthAdmission' datatype='datetime' name='[Calculation_708472524853575683]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Admission Date])' />
      </column>
      <column caption='Avg Total Bill' datatype='real' name='[Calculation_708472524854657028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Total Bill])' />
      </column>
      <column caption='Total Revenue' datatype='integer' name='[Calculation_708472524854853637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Bill])' />
      </column>
      <column caption='AvgTotal Bill' datatype='real' name='[Calculation_708472524857057286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Total Bill])' />
      </column>
      <column caption='Avg AgePatient' datatype='real' name='[Calculation_708472524857532423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Age])' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='integer' name='[Number of Records]' role='measure' type='quantitative' user:auto-column='numrec'>
        <calculation class='tableau' formula='1' />
